static func generate() -> Dictionary:
	var terrain: Dictionary = {}
	var deposits: Dictionary = {}
	for y in range(MAP_SIZE.y):
		for x in range(MAP_SIZE.x):
			var cell := Vector2i(x, y)
			var ground_code: String = TERRAIN[y][x]
			var resource_code: String = DEPOSITS[y][x]
			if TERRAIN_TYPES.has(ground_code):
				terrain[cell] = TERRAIN_TYPES[ground_code]
			if RESOURCE_TYPES.has(resource_code):
				deposits[cell] = RESOURCE_TYPES[resource_code]
	return {"terrain": terrain, "deposits": deposits, "camp_cell": CAMP_CELL, "map_size": MAP_SIZE}
